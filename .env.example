# Copy to .env (local dev: .env.local). NEXT_PUBLIC_* are baked in at build time.
NEXT_PUBLIC_SITE_URL=https://phatracare.phatra-leasing.com
# Google Tag Manager container, e.g. GTM-XXXXXXX (empty = GTM disabled)
NEXT_PUBLIC_GTM_ID=
# LINE OA add-friend URL, e.g. https://line.me/R/ti/p/@phatracare
NEXT_PUBLIC_LINE_URL=https://line.me
# Show the on-page GA4 event inspector + toasts (true for staging/demo only)
NEXT_PUBLIC_GA4_DEBUG=false
# Host port for docker compose
PORT=3000
